# Backend URL, with or without the trailing /api
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_GOOGLE_CLIENT_ID=

# Optional separate Socket.IO origin; defaults to the API origin
REACT_APP_SOCKET_URL=http://localhost:5000

# Optional TURN relay for calls that cannot connect peer-to-peer
REACT_APP_TURN_URL=
REACT_APP_TURN_USERNAME=
REACT_APP_TURN_CREDENTIAL=
