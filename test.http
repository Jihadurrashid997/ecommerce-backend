# নিচে রেসপন্সে যে নতুন token পাবেন, সেটি কপি করে ২ নম্বর রিকোয়েস্টে বসাবেন।
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
    "email": "jihad@gmail.com",
    "password": "123456"
}


