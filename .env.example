# Required backend settings
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Messenger Message Request spam protection
MESSENGER_MESSAGE_REQUESTS_PER_24H=5
MESSENGER_MESSAGE_REQUEST_DELETE_COOLDOWN_DAYS=30

# Additional allowed frontend origins, comma-separated
CORS_ORIGINS=

# Persistent media storage (required for production uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional; required for email-based password reset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Optional public logo URL for branded email templates
EMAIL_LOGO_URL=

# Scalable group voice/video calls (LiveKit Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SSLCommerz sandbox only. Live mode is disabled in application code.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
# Reserved for a separately approved future live setup; not used while live mode is disabled.
SSLCOMMERZ_LIVE_STORE_ID=
SSLCOMMERZ_LIVE_STORE_PASSWORD=
