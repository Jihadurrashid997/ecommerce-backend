# Required backend settings
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Additional allowed frontend origins, comma-separated
CORS_ORIGINS=

# Persistent media storage (required for production uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (required for email verification and password reset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_LOGO_URL=

# Scalable group voice/video calls (LiveKit Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SSLCommerz (optional; use sandbox credentials until production is approved)
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_IS_LIVE=false
